# CapitalScope Terminal — Environment Variables
# Copy this file to .env.local and fill in your keys

# ─── AI Features (Gold Mining Scanner, Deep Dive, Earnings, Research Agents) ───
# Without this key, all AI agents fall back to mock/demo data silently.
# Get your key at: https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── Optional: Financial Data APIs ─────────────────────────────────────────────
# Yahoo Finance (proxied via Vite) does NOT require a key.
#
# Financial Modeling Prep — used for analyst ratings (optional)
# Get at: https://financialmodelingprep.com/developer/docs/
VITE_FMP_API_KEY=your-fmp-key-here

# Finnhub — used for analyst ratings / news sentiment (optional)
# Get at: https://finnhub.io/register
VITE_FINNHUB_API_KEY=your-finnhub-key-here

# ─── Backend ────────────────────────────────────────────────────────────────────
# FastAPI backend must run on port 8000 alongside the Vite dev server.
# Start with: uvicorn main:app --reload --port 8000
# The Vite proxy (/api/portfolio → http://127.0.0.1:8000) handles routing.
# No env var needed for the backend URL in development.
